{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ermias/task",
  "title": "task",
  "description": "One link in the task chain.",
  "$comment": "DRAFT. Owner approval required before implementation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "state": {
      "enum": [
        "done",
        "current",
        "waiting"
      ]
    },
    "step": {
      "type": "integer"
    },
    "steps_total": {
      "type": "integer"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "state"
  ]
}
